# Agent Gateway Configuration

# Environment
GATEWAY_ENV=development
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO

# Database
GATEWAY_DB_PATH=/data/ai-platform/gateway.db

# Authentication
GATEWAY_JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
GATEWAY_JWT_EXPIRY_MINUTES=15
GATEWAY_REFRESH_TOKEN_EXPIRY_DAYS=7

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Claude (optional, for Phase 7+)
# CLAUDE_API_KEY=sk-ant-...
CLAUDE_API_ENDPOINT=https://api.anthropic.com/v1/messages
